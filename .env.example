# BotFather token. Never commit a real value.
BOT_TOKEN=

# Optional: leave unset to allow every Telegram user to have an isolated session.
OWNER_TELEGRAM_ID=

# Required for GramJS user-account login. Keep the existing Railway values.
API_ID=
API_HASH=

# Railway Volume mount. Use /data in production.
DATA_DIR=/data

# Optional safety cap for one source scan.
MAX_DISCOVERY_ITEMS=25000

NODE_ENV=production
LOG_LEVEL=info
# BotFather token. Never commit a real value.
BOT_TOKEN=

# Optional: leave unset to allow every Telegram user to have an isolated session.
OWNER_TELEGRAM_ID=

# Required for GramJS user-account login. Keep the existing Railway values.
API_ID=
API_HASH=

# Railway Volume mount. Use /data in production.
DATA_DIR=/data

# Optional safety cap for one source scan.
MAX_DISCOVERY_ITEMS=25000

# Optional local deadline for one Telegram request (milliseconds).
# 0 is the safe default: GramJS requests cannot be cancelled after they reach
# Telegram, so an unknown result must never be retried automatically.
TRANSFER_ITEM_TIMEOUT_MS=0

# Keep Telegram request concurrency conservative to avoid long FloodWait pauses.
MAX_TRANSFER_WORKERS=2
MAX_UPLOAD_WORKERS=4
# Number of items reserved by a worker before it checkpoints them one by one.
TRANSFER_BATCH_SIZE=10

# Poll the source for new matching files while a transfer is running.
LIVE_POLL_INTERVAL_MS=15000

# Automatically release a Telegram operation that remains stuck (milliseconds).
TRANSFER_STALL_TIMEOUT_MS=3600000

NODE_ENV=production
LOG_LEVEL=info
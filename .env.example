# Telegram BotFather token. Never commit a real value.
BOT_TOKEN=

# Your numeric Telegram ID. Only this user can control the bot.
OWNER_TELEGRAM_ID=

# Telegram API credentials from my.telegram.org for old-history migration.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Persistent directory. On Railway, mount a Volume at /data.
DATA_DIR=/data
NODE_ENV=production
LOG_LEVEL=info
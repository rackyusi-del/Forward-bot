# BotFather token. Never commit a real value.
BOT_TOKEN=

# Optional: leave unset to allow every Telegram user to have an isolated session.
OWNER_TELEGRAM_ID=

# Required for GramJS user-account login. Keep the existing Railway values.
API_ID=
API_HASH=

# Railway Volume mount. Use /data in production.
DATA_DIR=/data

# Optional safety cap for one source scan.
MAX_DISCOVERY_ITEMS=25000

# Watchdog for one Telegram item transfer attempt (milliseconds).
# A timed-out attempt reconnects and retries automatically.
TRANSFER_ITEM_TIMEOUT_MS=120000

# Keep Telegram request concurrency conservative to avoid long FloodWait pauses.
MAX_TRANSFER_WORKERS=2
MAX_UPLOAD_WORKERS=8

# Poll the source for new matching files while a transfer is running.
LIVE_POLL_INTERVAL_MS=15000

NODE_ENV=production
LOG_LEVEL=info